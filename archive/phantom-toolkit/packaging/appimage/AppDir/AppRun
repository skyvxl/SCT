#!/usr/bin/env bash
set -euo pipefail

APPDIR="${APPDIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
APPIMAGE_PATH="${APPIMAGE:-}"

show_error() {
  local title="$1"
  local msg="$2"

  if command -v zenity >/dev/null 2>&1; then
    zenity --error --title="$title" --text="$msg" 2>/dev/null || true
  elif command -v kdialog >/dev/null 2>&1; then
    kdialog --error "$msg" --title "$title" 2>/dev/null || true
  elif command -v xmessage >/dev/null 2>&1; then
    xmessage -center -title "$title" "$msg" 2>/dev/null || true
  else
    printf '%s: %s\n' "$title" "$msg" >&2
  fi
}

detect_steam_root() {
  if [[ -n "${STEAM_ROOT:-}" && -d "${STEAM_ROOT:-}/steamapps" ]]; then
    echo "${STEAM_ROOT}"
    return 0
  fi

  # Native Steam
  for p in "$HOME/.steam/steam" "$HOME/.local/share/Steam"; do
    if [[ -d "$p/steamapps" ]]; then
      echo "$p"
      return 0
    fi
  done

  # Flatpak Steam
  fp="$HOME/.var/app/com.valvesoftware.Steam/data/Steam"
  if [[ -d "$fp/steamapps" ]]; then
    echo "$fp"
    return 0
  fi

  return 1
}

detect_running_game_appid() {
  # Match Proton/Wine commandlines containing the Windows exe names.
  if ps -eo args 2>/dev/null | grep -Fqi "eldenring.exe"; then
    echo "1245620"
    return 0
  fi
  if ps -eo args 2>/dev/null | grep -Fqi "darksoulsiii.exe"; then
    echo "374320"
    return 0
  fi
  return 1
}

find_proton() {
  local steam_root="$1"

  shopt -s nullglob
  local candidates=(
    "$steam_root/steamapps/common/Proton - Experimental/proton"
    "$steam_root/steamapps/common/Proton"*"/proton"
    "$steam_root/steamapps/common/GE-Proton"*"/proton"
    "$steam_root/compatibilitytools.d/"*"/proton"
  )
  shopt -u nullglob

  for p in "${candidates[@]}"; do
    if [[ -x "$p" ]]; then
      echo "$p"
      return 0
    fi
  done

  return 1
}

linux_to_wine_z_path() {
  # Convert /home/user/foo -> Z:\home\user\foo
  # This is used for env vars consumed by a Windows Python process under Wine.
  local p="$1"
  p="${p//\//\\}"
  echo "Z:${p}"
}

exe="$APPDIR/PhantomToolkit.exe"
if [[ ! -f "$exe" ]]; then
  show_error "Phantom Toolkit" "Missing PhantomToolkit.exe inside AppImage (expected at: $exe)"
  exit 1
fi

steam_root="$(detect_steam_root || true)"
if [[ -z "$steam_root" ]]; then
  show_error "Phantom Toolkit" "Could not locate Steam installation.\n\nInstall Steam (native or Flatpak), then try again.\nOr set STEAM_ROOT to your Steam folder."
  exit 1
fi

appid="$(detect_running_game_appid || true)"
if [[ -z "$appid" ]]; then
  show_error "Phantom Toolkit" "No supported game detected.\n\nStart Elden Ring or Dark Souls III in Steam, then launch Phantom Toolkit."
  exit 1
fi

compatdata="${STEAM_COMPAT_DATA_PATH:-$steam_root/steamapps/compatdata/$appid}"
if [[ ! -d "$compatdata" ]]; then
  show_error "Phantom Toolkit" "Compatdata prefix not found:\n$compatdata\n\nLaunch the game at least once via Steam, then try again."
  exit 1
fi

proton="${PHANTOM_PROTON:-}"
if [[ -z "$proton" ]]; then
  proton="$(find_proton "$steam_root" || true)"
fi
if [[ -z "$proton" || ! -x "$proton" ]]; then
  show_error "Phantom Toolkit" "Could not find Proton.\n\nInstall Proton in Steam (e.g. Proton - Experimental) or set PHANTOM_PROTON=/path/to/proton."
  exit 1
fi

pick_free_port() {
  if command -v python3 >/dev/null 2>&1; then
    python3 - <<'PY'
import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()
PY
    return 0
  fi
  if command -v python >/dev/null 2>&1; then
    python - <<'PY'
import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()
PY
    return 0
  fi
  echo "8000"
}

wait_for_server() {
  local url="$1"
  local deadline=$((SECONDS + 20))

  local host=""
  local port=""
  if [[ "$url" =~ ^https?://([^:/]+):([0-9]+) ]]; then
    host="${BASH_REMATCH[1]}"
    port="${BASH_REMATCH[2]}"
  fi

  http_ping() {
    local ping_url="${url%/}/ping"
    if command -v curl >/dev/null 2>&1; then
      curl -fsS --max-time 1 "$ping_url" >/dev/null 2>&1
      return $?
    fi
    if command -v wget >/dev/null 2>&1; then
      wget -q -T 1 -O - "$ping_url" >/dev/null 2>&1
      return $?
    fi
    return 127
  }

  tcp_ping() {
    # Best-effort ping without curl/wget. Prefer Python; fall back to bash /dev/tcp.
    if command -v python3 >/dev/null 2>&1; then
      python3 - <<PY 2>/dev/null
import socket, sys
host = ${host@Q}
port = int(${port:-0})
if not host or port <= 0:
    sys.exit(2)
s = socket.socket()
s.settimeout(1.0)
try:
    s.connect((host, port))
    s.sendall(b"GET /ping HTTP/1.0\\r\\nHost: " + host.encode("utf-8") + b"\\r\\n\\r\\n")
    data = s.recv(128)
    sys.exit(0 if b"200" in data or b"ok" in data.lower() else 1)
except Exception:
    sys.exit(1)
finally:
    try: s.close()
    except Exception: pass
PY
      return $?
    fi
    if command -v python >/dev/null 2>&1; then
      python - <<PY 2>/dev/null
import socket, sys
host = ${host@Q}
port = int(${port:-0})
if not host or port <= 0:
    sys.exit(2)
s = socket.socket()
s.settimeout(1.0)
try:
    s.connect((host, port))
    s.sendall("GET /ping HTTP/1.0\\r\\nHost: %s\\r\\n\\r\\n" % host)
    data = s.recv(128)
    sys.exit(0 if ("200" in data) or ("ok" in data.lower()) else 1)
except Exception:
    sys.exit(1)
finally:
    try: s.close()
    except Exception: pass
PY
      return $?
    fi
    # /dev/tcp is a bash feature; may be disabled in some builds.
    if [[ -n "$host" && -n "$port" ]]; then
      (exec 3<>"/dev/tcp/$host/$port") >/dev/null 2>&1 || return 1
      printf 'GET /ping HTTP/1.0\r\nHost: %s\r\n\r\n' "$host" >&3 || true
      # Read a tiny amount; we just need to see that it responded.
      local line=""
      IFS= read -r -t 1 line <&3 || true
      exec 3<&- 3>&- || true
      [[ "$line" == *"200"* || "$line" == *"ok"* ]]
      return $?
    fi
    return 1
  }

  while (( SECONDS < deadline )); do
    if http_ping; then
      return 0
    fi
    if tcp_ping; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

open_url() {
  local url="$1"
  if [[ -n "${PHANTOM_BROWSER_CMD:-}" ]]; then
    # shellcheck disable=SC2086
    nohup ${PHANTOM_BROWSER_CMD} "$url" >/dev/null 2>&1 &
    return 0
  fi

  # Prefer app-mode when chromium is available (looks like a desktop window).
  if command -v chromium >/dev/null 2>&1; then
    nohup chromium --app="$url" >/dev/null 2>&1 &
    return 0
  fi
  if command -v google-chrome >/dev/null 2>&1; then
    nohup google-chrome --app="$url" >/dev/null 2>&1 &
    return 0
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    nohup xdg-open "$url" >/dev/null 2>&1 &
    return 0
  fi
  return 1
}

export STEAM_COMPAT_APP_ID="$appid"
export STEAM_COMPAT_DATA_PATH="$compatdata"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$steam_root"

game_key=""
if [[ "$appid" == "1245620" ]]; then
  game_key="eldenring"
elif [[ "$appid" == "374320" ]]; then
  game_key="ds3"
fi

# If the user placed items/ next to the AppImage, point the Windows process to it.
# Prefer items/<game_key> if present (repo layout).
if [[ -n "$APPIMAGE_PATH" ]]; then
  appimage_dir="$(cd "$(dirname "$APPIMAGE_PATH")" && pwd)"
  if [[ -n "$game_key" && -d "$appimage_dir/items/$game_key" ]]; then
    export PHANTOM_ITEMS_DIR="$(linux_to_wine_z_path "$appimage_dir/items/$game_key")"
  elif [[ -d "$appimage_dir/items" ]]; then
    export PHANTOM_ITEMS_DIR="$(linux_to_wine_z_path "$appimage_dir/items")"
  fi
fi

export PHANTOM_HOST="${PHANTOM_HOST:-127.0.0.1}"
export PHANTOM_PORT="${PHANTOM_PORT:-$(pick_free_port)}"

# Start native Linux host bridge (dialogs + screenshots) when bundled.
bridge_pid=""
if [[ -x "$APPDIR/PhantomHostBridge" ]]; then
  bridge_port="${PHANTOM_HOST_BRIDGE_PORT:-$(pick_free_port)}"
  bridge_url="http://127.0.0.1:${bridge_port}"
  "$APPDIR/PhantomHostBridge" --host 127.0.0.1 --port "${bridge_port}" &
  bridge_pid=$!
  # Wait briefly for the bridge to become reachable (avoids first-click races).
  if wait_for_server "${bridge_url}"; then
    export PHANTOM_HOST_BRIDGE_PORT="${bridge_port}"
    export PHANTOM_HOST_BRIDGE_URL="${bridge_url}"
  else
    # If the bridge didn't come up, don't let the Windows backend hang on it.
    kill "$bridge_pid" >/dev/null 2>&1 || true
    bridge_pid=""
  fi
fi

# Under Proton, the embedded pywebview (WinForms fallback) frequently crashes.
# Run server-only and open the URL from Linux instead.
export PHANTOM_NO_WEBVIEW="${PHANTOM_NO_WEBVIEW:-1}"
# Pass real Linux HOME so the Wine process can find Steam paths and open native dialogs
export PHANTOM_LINUX_HOME="$HOME"
export PHANTOM_LAUNCHED_BY_APPIMAGE="1"

url="http://${PHANTOM_HOST}:${PHANTOM_PORT}"

# Start the Proton-side backend in its own process group so we can reliably
# terminate *all* child processes when the UI closes.
if command -v setsid >/dev/null 2>&1; then
  setsid "$proton" run "$exe" --no-webview --launched-by-appimage --host "${PHANTOM_HOST}" --port "${PHANTOM_PORT}" &
else
  "$proton" run "$exe" --no-webview --launched-by-appimage --host "${PHANTOM_HOST}" --port "${PHANTOM_PORT}" &
fi
tool_pid=$!

cleanup() {
  # Ensure the Proton-side backend doesn't linger after GUI closes.
  # Prefer killing the backend's process group (but never kill our own group).
  local self_pgid=""
  local target_pgid=""
  if command -v ps >/dev/null 2>&1; then
    self_pgid="$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ' || true)"
    target_pgid="$(ps -o pgid= -p "$tool_pid" 2>/dev/null | tr -d ' ' || true)"
  fi
  if [[ -n "${target_pgid:-}" && -n "${self_pgid:-}" && "$target_pgid" != "$self_pgid" ]]; then
    kill -- -"${target_pgid}" >/dev/null 2>&1 || true
  else
    # If we launched with setsid, tool_pid is typically the group leader anyway.
    kill -- -"$tool_pid" >/dev/null 2>&1 || true
  fi
  kill "$tool_pid" >/dev/null 2>&1 || true

  # Kill any remaining PhantomToolkit.exe started by Proton (should not touch the game).
  if command -v pkill >/dev/null 2>&1; then
    pkill -TERM -f "PhantomToolkit\\.exe" >/dev/null 2>&1 || true
    sleep 0.2
    pkill -KILL -f "PhantomToolkit\\.exe" >/dev/null 2>&1 || true
  fi

  # Ensure the wine prefix is torn down (Proton can leave wineserver running).
  "$proton" run wineserver -k >/dev/null 2>&1 || true

  # Last resort: if still alive, SIGKILL.
  sleep 0.2
  kill -0 "$tool_pid" >/dev/null 2>&1 && kill -9 "$tool_pid" >/dev/null 2>&1 || true
  if [[ -n "${bridge_pid:-}" ]]; then
    kill "$bridge_pid" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

if ! wait_for_server "$url"; then
  show_error "Phantom Toolkit" "Phantom Toolkit started, but the backend did not become reachable:\n\n$url\n\nCheck phantomtoolkit_startup.log for details."
fi

if [[ -x "$APPDIR/PhantomToolkitGui" ]]; then
  "$APPDIR/PhantomToolkitGui" --url "$url" || true
  # Closing the GUI should fully stop the backend.
  exit 0
else
  open_url "$url" || true
fi

wait "$tool_pid"

